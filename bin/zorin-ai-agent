#!/usr/bin/env bash
# zorin-ai-agent — launch an AI coding agent from the menu, installing it
# on first use. Usage: zorin-ai-agent <codex|claude|opencode|grok> [args...]
set -u

AGENT="${1:-}"; shift || true

# mise-managed node/npm lives behind the profile hooks; pull it in for this
# non-login shell so npm and the agent shims resolve.
if [ -f /etc/profile.d/zorin-ai-mise.sh ]; then
  # shellcheck disable=SC1091
  . /etc/profile.d/zorin-ai-mise.sh
fi

declare -A PKG=(
  [codex]="@openai/codex"
  [claude]="@anthropic-ai/claude-code"
  [opencode]="opencode-ai"
  [grok]="@vibe-kit/grok-cli"
)

if [ -z "$AGENT" ] || [ -z "${PKG[$AGENT]:-}" ]; then
  echo "usage: zorin-ai-agent <codex|claude|opencode|grok> [args...]" >&2
  exit 1
fi

if ! command -v "$AGENT" >/dev/null 2>&1; then
  echo "$AGENT is not installed yet."
  if command -v zenity >/dev/null 2>&1; then
    zenity --question --no-wrap \
      --text="$AGENT is not installed.\n\nInstall it now with npm (needs node — included with zorin-ai)?" \
      || exit 1
  fi
  if ! command -v npm >/dev/null 2>&1; then
    echo "npm not found — install node first (mise: 'mise install node')." >&2
    read -r -n 1 -s -p "Press any key to close..."
    exit 1
  fi
  echo "Installing ${PKG[$AGENT]} ..."
  npm install -g "${PKG[$AGENT]}" || {
    echo "install failed"
    read -r -n 1 -s -p "Press any key to close..."
    exit 1
  }
fi

exec "$AGENT" "$@"
